{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Atelier.Framework.Identity": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "atelier-identity-service",
    "Audience": "atelier-api",
    "SigningKey": "",
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "ValidateSigningKey": true,
    "ClockSkew": "00:00:30",
    "TokenLifetime": "01:00:00"
  },
  "Oidc": {
    "EnableOidc": true,
    "DefaultProvider": "azuread",
    "EnableTokenValidation": true,
    "EnableAutomaticTokenRefresh": true,
    "ExcludedPaths": ["/health", "/metrics", "/swagger", "/login", "/callback"],
    "RequireHttps": true,
    "Providers": {
      "azuread": {
        "Authority": "https://login.microsoftonline.com/{tenant-id}/v2.0",
        "ClientId": "your-azure-ad-client-id",
        "ClientSecret": "",
        "RedirectUri": "https://localhost:7001/callback/azuread",
        "PostLogoutRedirectUri": "https://localhost:7001/logout",
        "Scopes": ["openid", "profile", "email", "User.Read"],
        "ResponseTypes": ["code"],
        "ResponseMode": "query",
        "RequireHttps": true,
        "TokenLifetime": "01:00:00",
        "RefreshTokenLifetime": "30.00:00:00",
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true,
        "ValidateIssuerSigningKey": true,
        "ClockSkew": "00:05:00",
        "AdditionalParameters": {
          "prompt": "select_account"
        },
        "ClaimsMapping": {
          "SubjectClaim": "oid",
          "NameClaim": "name",
          "EmailClaim": "email",
          "UsernameClaim": "preferred_username",
          "RolesClaim": "roles",
          "ScopesClaim": "scp",
          "TenantIdClaim": "tid",
          "SessionIdClaim": "sid",
          "CustomMappings": {
            "upn": "email",
            "given_name": "first_name",
            "family_name": "last_name"
          }
        }
      },
      "auth0": {
        "Authority": "https://your-domain.auth0.com",
        "ClientId": "your-auth0-client-id",
        "ClientSecret": "",
        "RedirectUri": "https://localhost:7001/callback/auth0",
        "PostLogoutRedirectUri": "https://localhost:7001/logout",
        "Scopes": ["openid", "profile", "email"],
        "ResponseTypes": ["code"],
        "ResponseMode": "query",
        "RequireHttps": true,
        "TokenLifetime": "01:00:00",
        "RefreshTokenLifetime": "30.00:00:00",
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true,
        "ValidateIssuerSigningKey": true,
        "ClockSkew": "00:05:00",
        "AdditionalParameters": {
          "audience": "https://your-api.com",
          "prompt": "login"
        },
        "ClaimsMapping": {
          "SubjectClaim": "sub",
          "NameClaim": "name",
          "EmailClaim": "email",
          "UsernameClaim": "nickname",
          "RolesClaim": "https://schemas.auth0.com/roles",
          "ScopesClaim": "scope",
          "TenantIdClaim": "https://schemas.auth0.com/tenant_id",
          "SessionIdClaim": "sid",
          "CustomMappings": {
            "given_name": "first_name",
            "family_name": "last_name",
            "picture": "avatar"
          }
        }
      },
      "keycloak": {
        "Authority": "https://your-keycloak-server/auth/realms/your-realm",
        "ClientId": "your-keycloak-client-id",
        "ClientSecret": "",
        "RedirectUri": "https://localhost:7001/callback/keycloak",
        "PostLogoutRedirectUri": "https://localhost:7001/logout",
        "Scopes": ["openid", "profile", "email"],
        "ResponseTypes": ["code"],
        "ResponseMode": "query",
        "RequireHttps": true,
        "TokenLifetime": "01:00:00",
        "RefreshTokenLifetime": "30.00:00:00",
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true,
        "ValidateIssuerSigningKey": true,
        "ClockSkew": "00:05:00",
        "AdditionalParameters": {
          "kc_idp_hint": "your-identity-provider"
        },
        "ClaimsMapping": {
          "SubjectClaim": "sub",
          "NameClaim": "name",
          "EmailClaim": "email",
          "UsernameClaim": "preferred_username",
          "RolesClaim": "realm_access",
          "ScopesClaim": "scope",
          "TenantIdClaim": "tenant_id",
          "SessionIdClaim": "sid",
          "CustomMappings": {
            "given_name": "first_name",
            "family_name": "last_name",
            "realm_access.roles": "roles"
          }
        }
      },
      "google": {
        "Authority": "https://accounts.google.com",
        "ClientId": "your-google-client-id",
        "ClientSecret": "",
        "RedirectUri": "https://localhost:7001/callback/google",
        "PostLogoutRedirectUri": "https://localhost:7001/logout",
        "Scopes": ["openid", "profile", "email"],
        "ResponseTypes": ["code"],
        "ResponseMode": "query",
        "RequireHttps": true,
        "TokenLifetime": "01:00:00",
        "RefreshTokenLifetime": "30.00:00:00",
        "ValidateIssuer": true,
        "ValidateAudience": true,
        "ValidateLifetime": true,
        "ValidateIssuerSigningKey": true,
        "ClockSkew": "00:05:00",
        "AdditionalParameters": {
          "access_type": "offline",
          "prompt": "consent"
        },
        "ClaimsMapping": {
          "SubjectClaim": "sub",
          "NameClaim": "name",
          "EmailClaim": "email",
          "UsernameClaim": "email",
          "RolesClaim": "roles",
          "ScopesClaim": "scope",
          "TenantIdClaim": "hd",
          "SessionIdClaim": "sid",
          "CustomMappings": {
            "given_name": "first_name",
            "family_name": "last_name",
            "picture": "avatar"
          }
        }
      }
    },
    "Authentication": {
      "EnableAuthentication": true,
      "RequireAuthentication": true,
      "ProviderName": null,
      "ExcludedPaths": ["/health", "/metrics", "/swagger", "/login", "/callback"],
      "EnableUserInfoExtraction": true
    }
  }
}
