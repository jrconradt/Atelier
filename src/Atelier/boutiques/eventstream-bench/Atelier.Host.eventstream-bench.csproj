<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Atelier.Host.eventstream-bench</AssemblyName>
    <RootNamespace>Atelier.Host.eventstream-bench</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SelfContained)' == 'true'">
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimMode>link</TrimMode>
    <TrimmerRemoveSymbols>true</TrimmerRemoveSymbols>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Atelier.Framework.Infrastructure/Atelier.Framework.Infrastructure.csproj" />
    <ProjectReference Include="../../Atelier.Framework.Context/Atelier.Framework.Context.csproj" />
    <ProjectReference Include="../../Atelier.Framework.Observability/Atelier.Framework.Observability.csproj" />
    <ProjectReference Include="../../Atelier.Framework.Outcomes/Atelier.Framework.Outcomes.csproj" />
    <ProjectReference Include="../../Atelier.Framework.Requisitions/Atelier.Framework.Requisitions.csproj" />
    <ProjectReference Include="../../Atelier.Framework.Offering/Atelier.Framework.Offering.csproj" />
    <ProjectReference Include="../../Atelier.Framework.Attache/Atelier.Framework.Attache.csproj" />
    <ProjectReference Include="../../Atelier.Framework.Facility/Atelier.Framework.Facility.csproj" />
    <ProjectReference Include="../../Atelier.Framework.EventStream/Atelier.Framework.EventStream.csproj" />
    <ProjectReference Include="../../benchmarks/eventstream-bench/Atelier.Bench.EventStream/Atelier.Bench.EventStream.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Grpc.AspNetCore" />
  </ItemGroup>
</Project>