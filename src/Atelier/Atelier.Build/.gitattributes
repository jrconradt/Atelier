# Atelier.Build - Line Ending Configuration
# Enforce LF line endings for all text files across all platforms

# Default: Auto-detect text files and normalize to LF
* text=auto eol=lf

# Explicitly mark text files
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf

# Denote binary files
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.nupkg binary
